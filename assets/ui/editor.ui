              <item row="2" column="0" colspan="4">
               <widget class="QPlainTextEdit" name="content_editor">
                <property name="font">
                 <font>
                  <family>微软雅黑</family>
                  <pointsize>12</pointsize>
                 </font>
                </property>
                <property name="cursor" stdset="0">
                 <cursorShape>ArrowCursor</cursorShape>
                </property>
                <property name="mouseTracking">
                 <bool>true</bool>
                </property>
                <property name="tabletTracking">
                 <bool>true</bool>
                </property>
                <property name="styleSheet">
                 <string notr="true">#content_editor {
    background-color: #FFFFFF;
    color: #1B1B1B;
    border: 1px solid #E6E6E6;
    border-radius: 6px;
    padding: 10px;
    selection-background-color: #CCE4F7;
    selection-color: #1B1B1B;
}
#content_editor:hover {
    border: 1px solid #D0D0D0;
}
#content_editor:focus {
    border: 1px solid #0067C0;
}
#content_editor QMenu {
    background-color: #FFFFFF;
    color: #1B1B1B;
    border: 1px solid #E6E6E6;
    border-radius: 5px;
}
#content_editor QMenu::item {
    padding: 4px 20px;
}
#content_editor QMenu::item:selected {
    background-color: #EAF3FC;
    color: #0067C0;
}
#content_editor QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 2px;
    border: none;
}
#content_editor QScrollBar::handle:vertical {
    background: #C9C9C9;
    border-radius: 4px;
    min-height: 24px;
}
#content_editor QScrollBar::handle:vertical:hover {
    background: #A9A9A9;
}
#content_editor QScrollBar::add-line:vertical,
#content_editor QScrollBar::sub-line:vertical {
    height: 0px;
    background: transparent;
    border: none;
}
#content_editor QScrollBar::add-page:vertical,
#content_editor QScrollBar::sub-page:vertical {
    background: transparent;
}</string>
                </property>
               </widget>
              </item>
